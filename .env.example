# Empty values keep every secret-bearing module inert.
# Copy to .env and fill only what you use. Do not commit .env.

# Read at build time. Leave empty to keep @sentry/nuxt out of the build.
SENTRY_DSN=
# Build-time source map upload only. Leave empty to skip the upload.
SENTRY_AUTH_TOKEN=

# Auth routes stay unregistered unless supernuxt.auth is true.
# Even then, Postgres is not opened until both of these are set.
# BETTER_AUTH_SECRET must be at least 32 characters.
# DATABASE_URL must start with postgres:// or postgresql://.
# AUTH_SECRET is an alias when BETTER_AUTH_SECRET is empty.
BETTER_AUTH_SECRET=
DATABASE_URL=

# Optional GitHub OAuth. Both must be set, or neither is used.
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=
