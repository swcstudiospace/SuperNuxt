{
  "name": "supernuxt",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Nuxt 4 framework with TanStack, Rstack, a landing page, and built-in documentation.",
  "homepage": "https://github.com/swcstudiospace/SuperNuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swcstudiospace/SuperNuxt.git"
  },
  "bugs": {
    "url": "https://github.com/swcstudiospace/SuperNuxt/issues"
  },
  "keywords": [
    "tanstack-intent",
    "nuxt",
    "tanstack",
    "rstack",
    "supernuxt"
  ],
  "bin": {
    "supernuxt": "./packages/create-supernuxt/index.mjs",
    "create-supernuxt": "./packages/create-supernuxt/index.mjs"
  },
  "files": [
    "app",
    "server",
    "shared",
    "content",
    "public/brand/mark.svg",
    "public/brand/banner.jpg",
    "public/favicon.svg",
    "public/apple-touch-icon.png",
    "nuxt.config.ts",
    "deno.json",
    "jsr.json",
    "README.md",
    "config",
    "packages/create-supernuxt/index.mjs",
    "packages/create-supernuxt/mark.svg"
  ],
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxt dev --port 47821 --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --port 47821 --host 127.0.0.1",
    "postinstall": "npm run build -w @supernuxt/core && nuxt prepare",
    "test": "rs test",
    "lint": "rs lint",
    "format": "rs fmt",
    "check": "rs check",
    "lib": "rs lib",
    "rstack:dev": "rs dev --port 47831",
    "rstack:build": "rs build",
    "doctor": "RSDOCTOR=true rs build",
    "create": "node packages/create-supernuxt/index.mjs",
    "build:packages": "npm run build -w @supernuxt/core -w @supernuxt/nuxt --if-present"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@supernuxt/core": "0.2.0",
    "@supernuxt/nuxt": "0.2.0",
    "@tanstack/ai": "^0.69.0",
    "@tanstack/ai-vue": "^0.26.4",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/db": "^0.14.0",
    "@tanstack/highlight": "^1.1.0",
    "@tanstack/hotkeys": "^0.11.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/ranger": "^0.0.4",
    "@tanstack/vue-db": "^0.3.9",
    "@tanstack/vue-devtools": "^0.2.27",
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-hotkeys": "^0.13.0",
    "@tanstack/vue-pacer": "^0.2.0",
    "@tanstack/vue-query": "^5.104.2",
    "@tanstack/vue-query-devtools": "^6.3.2",
    "@tanstack/vue-router": "^1.170.40",
    "@tanstack/vue-store": "^0.11.2",
    "@tanstack/vue-table": "^9.3.1",
    "@tanstack/vue-virtual": "^3.13.45",
    "nuxt": "4.6.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@rsdoctor/core": "^1.6.5",
    "@tanstack/cli": "^0.71.1",
    "@tanstack/config": "^0.22.2",
    "@tanstack/intent": "^0.5.5",
    "rstack": "^0.8.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
